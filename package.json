{
  "name": "some-kids",
  "version": "1.0.0",
  "private": true,
  "description": "En trygg og rolig sosial kanal for barn",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "reset-link": "node --disable-warning=ExperimentalWarning server/cli.js reset-link",
    "reset-all": "node --disable-warning=ExperimentalWarning server/cli.js reset-all",
    "test-mail": "node --disable-warning=ExperimentalWarning server/cli.js test-mail",
    "verify-email": "node --disable-warning=ExperimentalWarning server/cli.js verify-email",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "express": "5.1.0",
    "nodemailer": "10.0.16"
  }
}
